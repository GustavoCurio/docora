# Configure no ambiente do servidor; o aplicativo não carrega .env automaticamente.
OPENAI_API_KEY=
OPENAI_MODEL=
# Modelos públicos: download só com autorização explícita; inferência local.
DOCORA_RETRIEVER=hybrid
DOCORA_RERANKER=none
DOCORA_ALLOW_MODEL_DOWNLOAD=0
# DOCORA_MODEL_CACHE=/tmp/docora-models
# DOCORA_DISABLE_EMBEDDINGS=1
# DOCORA_DISABLE_RERANKER=1
